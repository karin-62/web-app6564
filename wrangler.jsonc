{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app6564",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6afb7ace-39b2-463f-b749-a368f2b8c982","database_name": "web-app4" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "15266e8721b34f5f99e95e7e882f70e3" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
